# Copy this file to `.env` and fill in what you have. Nothing here is required
# to LAUNCH the app -- missing keys just mark the matching layer "unavailable".
# `.env` is gitignored; never commit real keys.

# --- LLM (OpenRouter is the chosen provider) ---
# Get a free key at https://openrouter.ai/keys (no card for the :free models).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free models rotate; this one is verified working Aug 2026. If it 404s/429s,
# try another :free model or the resilient auto-router `openrouter/free`.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Recommendation APIs (Phase 4) ---
# Music: Last.fm free key (no OAuth) -> https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Movies: TMDB free key (non-commercial) -> https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# arXiv needs no key.
