# Copy this file to `.env` and fill in what you have. Nothing here is required
# to LAUNCH the app -- missing keys just mark the matching layer "unavailable".
# `.env` is gitignored; never commit real keys.

# --- LLM (pick one; Groq is the recommended free week-1 choice) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Recommendation APIs (Phase 4) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TMDB_API_KEY=
# arXiv needs no key.
